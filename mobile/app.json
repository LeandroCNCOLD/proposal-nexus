{
  "expo": {
    "name": "CN Cold Sales",
    "slug": "cncold-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F2D5E"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "br.com.cncold.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F2D5E"
      },
      "package": "br.com.cncold.mobile",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "CN Cold precisa da sua localização para registrar visitas."
        }
      ]
    ],
    "owner": "355669",
    "scheme": "cncold",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a89ecbaf-d05a-4805-a67a-51052fbba1ad"
      }
    }
  }
}
